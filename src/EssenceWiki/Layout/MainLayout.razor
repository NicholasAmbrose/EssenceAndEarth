@inherits LayoutComponentBase
@implements IDisposable
@inject WikiService Data
@inject NavigationManager Nav
@inject IJSRuntime JS

<header class="topbar">
    <div class="topbar-inner">
        <button class="icon-btn menu-btn" aria-label="Open menu" @onclick="() => menuOpen = !menuOpen">
            <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" /></svg>
        </button>
        <a class="brand" href="">
            <img class="px" src="img/pack_icon.png" alt="" width="32" height="32" />
            <span>Essence <i>&amp;</i> Earth</span>
        </a>
        <nav class="topnav">
            <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="wiki">Wiki</NavLink>
            <NavLink href="recipes">Recipes</NavLink>
            <NavLink href="gallery">Gallery</NavLink>
            <NavLink href="download">Download</NavLink>
            <NavLink href="roadmap">Roadmap</NavLink>
        </nav>
        <div class="topbar-right">
            <button class="icon-btn" aria-label="Toggle dark mode" title="Toggle dark mode" @onclick="ToggleTheme">
                @if (dark)
                {
                    <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path d="M12 2v3m0 14v3M2 12h3m14 0h3M4.9 4.9 7 7m10 10 2.1 2.1M4.9 19.1 7 17m10-10 2.1-2.1" stroke="currentColor" stroke-width="2" /></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M20 15.3A8.5 8.5 0 0 1 8.7 4 8.5 8.5 0 1 0 20 15.3z" /></svg>
                }
            </button>
            @if (Data.Ready)
            {
                <a class="btn btn-primary btn-sm" href="@Data.Release.Download">
                    <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M11 3h2v10l3.5-3.5 1.4 1.4L12 16.8l-5.9-5.9 1.4-1.4L11 13zM4 19h16v2H4z" /></svg>
                    v@(Data.Release.Version)
                </a>
            }
        </div>
    </div>
</header>

@if (!Data.Ready)
{
    <div class="loading"><div class="spinner"></div>Loading the wiki…</div>
}
else
{
    <div class="shell">
        <aside class="sidebar @(menuOpen ? "open" : "")">
            <div class="search">
                <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M10 2a8 8 0 0 1 6.3 12.9l5.4 5.4-1.4 1.4-5.4-5.4A8 8 0 1 1 10 2zm0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12z" /></svg>
                <input id="search" type="search" placeholder="Search crops and essence" @bind="query" @bind:event="oninput" @onkeydown="SearchKey" aria-label="Search the wiki" />
            </div>
            @if (!string.IsNullOrWhiteSpace(query))
            {
                var hits = Data.Search(query, 12);
                <div class="search-results">
                    @if (hits.Count == 0)
                    {
                        <div class="muted small pad">Nothing matches “@query”.</div>
                    }
                    @foreach (var e in hits)
                    {
                        <a href="@e.Href" @onclick="Close">
                            <Icon Src="@e.Icon" Name="@e.Name" Size="24" />
                            <span>@e.Name<small>@e.Category.Title</small></span>
                        </a>
                    }
                </div>
            }
            <nav class="side-nav">
                <div class="side-group">
                    <div class="side-group-title">Overview</div>
                    <NavLink href="" Match="NavLinkMatch.All" @onclick="Close">Home</NavLink>
                    <NavLink href="recipes" @onclick="Close">All recipes</NavLink>
                    <NavLink href="gallery" @onclick="Close">Gallery</NavLink>
                    <NavLink href="download" @onclick="Close">Download</NavLink>
                    <NavLink href="roadmap" @onclick="Close">Roadmap</NavLink>
                </div>
                @foreach (var g in Data.Groups)
                {
                    <div class="side-group">
                        <div class="side-group-title">@g.Key</div>
                        @foreach (var c in g)
                        {
                            var active = Nav.ToBaseRelativePath(Nav.Uri).StartsWith($"wiki/{c.Slug}");
                            <NavLink href="@($"wiki/{c.Slug}")" Match="NavLinkMatch.Prefix" @onclick="Close">
                                <Icon Src="@c.Icon" Name="" Size="18" /> @c.Title <span class="count">@c.Entries.Count</span>
                            </NavLink>
                            @if (active)
                            {
                                <div class="side-sub">
                                    @foreach (var e in c.Entries)
                                    {
                                        <NavLink href="@e.Href" @onclick="Close">@e.Name</NavLink>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </nav>
            <div class="side-version">
                <div>Add-on <b>v@(Data.Release.Version)</b></div>
                <div>Bedrock <b>@Data.Release.MinBedrock+</b></div>
            </div>
        </aside>
        @if (menuOpen)
        {
            <div class="scrim" @onclick="Close"></div>
        }
        <main class="content">
            @Body
        </main>
    </div>
    <footer class="footer">
        <div class="footer-inner">
            <div>
                <div class="brand small"><img class="px" src="img/pack_icon.png" alt="" width="24" height="24" /> Essence &amp; Earth</div>
                <p class="muted small">Grow your resources from essence crops in Minecraft Bedrock. Every page is generated from the add-on's own files for v@(Data.Release.Version).</p>
            </div>
            <div class="footer-links">
                <a href="wiki">Wiki</a>
                <a href="recipes">Recipes</a>
                <a href="gallery">Gallery</a>
                <a href="@Data.Release.Repo">GitHub</a>
            </div>
        </div>
        <div class="footer-note muted small">Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.</div>
    </footer>
}

@code {
    bool menuOpen;
    bool dark = true;
    string query = "";

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await Data.EnsureLoadedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dark = await JS.InvokeAsync<string>("eeTheme.get") == "dark";
            StateHasChanged();
        }
    }

    async Task ToggleTheme()
    {
        dark = !dark;
        await JS.InvokeVoidAsync("eeTheme.set", dark ? "dark" : "light");
    }

    void Close() => menuOpen = false;

    void SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(query))
        {
            var first = Data.Search(query, 1).FirstOrDefault();
            if (first is not null) { Nav.NavigateTo(first.Href); query = ""; menuOpen = false; }
        }
        else if (e.Key == "Escape") query = "";
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        query = "";
        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
