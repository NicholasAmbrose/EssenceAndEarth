@inject WikiService Data

<section class="download-panel">
    <img class="px" src="img/pack_icon.png" alt="" width="56" height="56" />
    <div>
        <div class="download-title">Essence &amp; Earth v@(Data.Release.Version)</div>
        <div class="muted small">Minecraft Bedrock @Data.Release.MinBedrock or newer · one .mcaddon with both packs</div>
    </div>
    <div class="download-actions">
        <a class="btn btn-primary" href="@Data.Release.Download">Download .mcaddon</a>
        <a class="btn" href="download">How to install</a>
    </div>
</section>
