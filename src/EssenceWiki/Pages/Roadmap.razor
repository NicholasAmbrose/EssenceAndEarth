@page "/roadmap"

<PageTitle>Roadmap · Essence &amp; Earth</PageTitle>
<Breadcrumbs Here="Roadmap" />
<h1>Roadmap</h1>
<p class="lead">What has shipped and what is planned. Plans can change as the add-on gets played.</p>

@foreach (var phase in Phases)
{
    <h2 class="section-title">@phase.Title</h2>
    <div class="card-grid">
        @foreach (var item in phase.Items)
        {
            <div class="card">
                <div class="card-top">
                    <div class="card-title">@item.Name</div>
                    <span class="pill">@item.Status</span>
                </div>
                <div class="card-text">@item.Text</div>
            </div>
        }
    </div>
}

@code {
    record Item(string Name, string Status, string Text);
    record Phase(string Title, Item[] Items);

    static readonly Phase[] Phases =
    [
        new("Phase 1: Content and look",
        [
            new("More crops", "Done", "Resource crops across the essence tiers, from coal to netherite."),
            new("Better textures", "Done", "Gem-shaped essence tiers, gas-puff crop essence and crystal sprout crops."),
        ]),
        new("Phase 2: Better farming",
        [
            new("Essence farmland", "Done", "Five tiers of farmland that never dry out and give crops a chance of a second essence and seed."),
            new("Growth accelerators", "Done", "Five tiers of block that go below a crop to speed it up. Higher tiers reach further."),
            new("Balance settings", "Done", "Growth speed, drop chances and harvest amounts in one place, so they are easy to tune."),
            new("Farming rebalance", "Done", "New crop tiers, much bigger outputs for common resources, and rarer diamonds and emeralds."),
        ]),
        new("Phase 3: Progression",
        [
            new("Mob crops", "Done", "Nine crops named after mobs, from zombie to wither. Their essence crafts the real drops, such as string, gunpowder, ender pearls and nether stars."),
            new("Terra crop", "Done", "A crop that gives a steady supply of Terra Essence, with more on higher tiers of farmland."),
            new("Essence tools", "In progress", "The 3×3 harvesting sickle and replanting hoe are out. Armor is still to come."),
            new("Ores, mob drops and materials", "Done", "Essence Ore returns, mobs can drop Terra Essence, and Vita Ore leads to ingots, gemstones and fertilizer."),
            new("Full crop list", "Done", "Dozens of new crops, with themed ones for dyes, coral, honey and more, and essence that combines to make hundreds of things."),
            new("Infusion Altar", "Planned", "An altar and pedestals for crafting seeds, with soul jars for mob seeds."),
        ]),
        new("Phase 4: Polish and sharing",
        [
            new("Wiki", "Done", "This site, rebuilt from the add-on's own files on every update."),
            new("Machine support", "In progress", "Essence drops work with harvesting machines. Still needs testing in-game."),
            new("In-game guide book", "Done", "The Essence Guide: the basics of the add-on, readable without leaving the game."),
        ]),
    ];
}
